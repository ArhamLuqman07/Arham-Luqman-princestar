# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection (provided automatically by Cloud SQL integration at runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Session signing secret (auto-generated fallback used if omitted in local dev)
SESSION_SECRET="replace-with-strong-random-secret"

# Optional SMTP / Transactional Email settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PRINCE STAR <princestar.store@gmail.com>"
